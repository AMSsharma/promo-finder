# Copy to .env and fill in ONE of these. The first key found picks the provider,
# or force one with PROMO_PROVIDER / --provider.

# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free: https://console.groq.com/keys
GROQ_API_KEY=

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama at http://localhost:11434/v1, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=

# Optional overrides
# PROMO_PROVIDER=gemini
# PROMO_MODEL=gemini-2.5-flash
